# ===== 应用 =====
APP_NAME=智能简历投递系统
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
DATABASE_URL=mysql+asyncmy://root:djangotest@localhost:3306/resume_system
REDIS_URL=redis://redis:6379/0

# ===== JWT 认证 =====
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Kimi API（OpenAI 兼容） =====
KIMI_API_KEY=sk-lDK3CtZrwbKBaJtcNupVzGy27KMfi9Ng69IGAt1mvjiMANWd
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
