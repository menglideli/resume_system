# ===== 应用 =====
APP_NAME=智能简历投递系统
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
DATABASE_URL=mysql+asyncmy://root:root@db:3306/resume_system
REDIS_URL=redis://redis:6379/0

# ===== JWT 认证 =====
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 初始管理员（首次启动自动创建，已存在则忽略） =====
ADMIN_DEFAULT_PASSWORD=admin123

# ===== Kimi API（OpenAI 兼容，运行时可在后台管理页面修改，存 system_config 表） =====
KIMI_API_KEY=sk-your-moonshot-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-latest
KIMI_TIMEOUT=120
KIMI_MAX_TOKENS=4096

# ===== 文件存储 =====
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
MAX_UPLOAD_SIZE=20971520

# ===== PDF 渲染（留空则使用 Playwright 自带浏览器） =====
CHROMIUM_EXECUTABLE_PATH=

# ===== CORS（逗号分隔，* 表示全部） =====
CORS_ORIGINS=*
